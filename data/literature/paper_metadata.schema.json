{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labinstrumentvqa.local/schemas/paper_metadata.schema.json",
  "title": "LabInstrumentVQA Literature Paper Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paper_id",
    "title",
    "authors",
    "year",
    "venue",
    "publication_type",
    "source",
    "retrieved_at",
    "oa_status",
    "oa_urls",
    "pdf_urls_legal",
    "relevance_score",
    "matched_keywords",
    "matched_categories",
    "review_status",
    "selected_for_related_work"
  ],
  "properties": {
    "paper_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "authors": {"type": "array", "items": {"type": "string"}},
    "year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2100},
    "venue": {"type": "string"},
    "publication_type": {
      "type": "string",
      "enum": ["conference", "journal", "preprint", "repository", "unknown"]
    },
    "doi": {"type": ["string", "null"]},
    "ieee_article_number": {"type": ["string", "null"]},
    "volume": {"type": ["string", "null"]},
    "issue": {"type": ["string", "null"]},
    "pages": {"type": ["string", "null"]},
    "publisher": {"type": ["string", "null"]},
    "source": {"type": "string"},
    "source_query": {"type": ["string", "null"]},
    "source_url": {"type": ["string", "null"], "format": "uri"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "abstract": {"type": ["string", "null"]},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "subjects": {"type": "array", "items": {"type": "string"}},
    "oa_status": {
      "type": "string",
      "enum": ["open", "closed", "bronze", "green", "gold", "hybrid", "unknown"]
    },
    "oa_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "pdf_urls_legal": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "license": {"type": ["string", "null"]},
    "relevance_score": {"type": "number", "minimum": 0},
    "matched_keywords": {"type": "array", "items": {"type": "string"}},
    "matched_categories": {"type": "array", "items": {"type": "string"}},
    "instrument_type": {"type": "array", "items": {"type": "string"}},
    "measurement_type": {"type": "array", "items": {"type": "string"}},
    "figure_evidence_type": {"type": "array", "items": {"type": "string"}},
    "task_relevance": {"type": "array", "items": {"type": "string"}},
    "review_status": {
      "type": "string",
      "enum": ["seed", "new", "needs_review", "selected", "rejected"]
    },
    "notes": {"type": ["string", "null"]},
    "selected_for_related_work": {"type": "boolean"}
  }
}
